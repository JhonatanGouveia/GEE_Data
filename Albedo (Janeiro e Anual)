// ─── ROI: asset Jandira ───
var rj = ee.FeatureCollection('projects/tcc-aracoiaba-da-serra/assets/Jandira');

// ─── Funções: máscara, escalonamento e albedo de Liang (2001) ───
function maskClouds(image) {
  var qa = image.select('QA_PIXEL');
  return image.updateMask(
    qa.bitwiseAnd(1 << 3).eq(0)
      .and(qa.bitwiseAnd(1 << 4).eq(0))
      .and(qa.bitwiseAnd(1 << 5).eq(0))
  );
}

function scaleImage(image) {
  var bands = image
    .select(['SR_B2','SR_B4','SR_B5','SR_B6','SR_B7'])
    .multiply(0.0000275).add(-0.2);
  return image.addBands(bands, null, true);
}

function calcAlbedo(image) {
  return image
    .expression(
      '0.356*b2 + 0.130*b4 + 0.373*b5 + 0.085*b6 + 0.072*b7 - 0.0018',
      { b2: image.select('SR_B2'), b4: image.select('SR_B4'),
        b5: image.select('SR_B5'), b6: image.select('SR_B6'),
        b7: image.select('SR_B7') })
    .rename('albedo')
    .copyProperties(image, ['system:time_start']);
}

function pipeline(col) {
  return col.map(maskClouds).map(scaleImage).map(calcAlbedo);
}

// ─── Parte 2 — composições sazonais ───
// ─── Coleção base: L8 + L9, 2018–2024, nuvem < 25% ───
var l8 = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2');
var l9 = ee.ImageCollection('LANDSAT/LC09/C02/T1_L2');

function baseFilter(col) {
  return col
    .filterBounds(rj)
    .filterDate('2018-01-01', '2024-12-31')
    .filter(ee.Filter.lt('CLOUD_COVER', 25));  // relaxado para verão
}

var base = baseFilter(l8).merge(baseFilter(l9));

// ─── Composição A: apenas janeiro (referência InVEST) ───
var albedo_jan = pipeline(
  base.filter(ee.Filter.calendarRange(1, 1, 'month'))
).median().clip(rj);

// ─── Composição B: verão ampliado dez–fev (fallback) ───
var albedo_verao = pipeline(
  base.filter(ee.Filter.calendarRange(12, 2, 'month'))
).median().clip(rj);

// ─── Composição final: janeiro onde válido, verão onde há lacuna ───
var albedo_final = albedo_jan
  .unmask(albedo_verao)   // preenche NaN do janeiro com valor de verão
  .rename('albedo')
  .clip(rj);

// ─── Parte 3 — visualização e exportação ───
// ─── Paleta para verão úmido (faixa mais estreita que anual) ───
var visParams = {
  min: 0.02, max: 0.25,
  palette: ['1a4a2e','4a8c5c','a8d4a0','f5f0d0','e8d870','f5f5f5']
};  // verde escuro (mata) → bege (solo) → branco (urbano/telhados)

Map.centerObject(rj, 12);
Map.addLayer(rj,           {color: 'red'}, 'ROI — Jandira');
Map.addLayer(albedo_jan,   visParams, 'Albedo — janeiro (referência)');
Map.addLayer(albedo_verao, visParams, 'Albedo — verão dez–fev');
Map.addLayer(albedo_final, visParams, 'Albedo final (jan + fallback verão)', true);

// ─── Exportação: camada final para InVEST ───
Export.image.toDrive({
  image: albedo_final,
  description: 'albedo_jandira_invest_verao',
  folder: 'GEE_exports',
  fileNamePrefix: 'albedo_jandira_jan_verao_2018_2024',
  region: rj.geometry(),
  scale: 30,
  crs: 'EPSG:31983',           // SIRGAS 2000 / UTM zone 23S (SP)
  maxPixels: 1e10,
  fileFormat: 'GeoTIFF'
});

// ─── Exportação opcional: camada de janeiro isolada ───
Export.image.toDrive({
  image: albedo_jan,
  description: 'albedo_jandira_apenas_janeiro',
  folder: 'GEE_exports',
  fileNamePrefix: 'albedo_jandira_jan_somente_2018_2024',
  region: rj.geometry(),
  scale: 30,
  crs: 'EPSG:31983',
  maxPixels: 1e10,
  fileFormat: 'GeoTIFF'
});

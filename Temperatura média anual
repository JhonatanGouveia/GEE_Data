// ====================================================================
// CONFIGURAÇÕES
// ====================================================================
var ano = 2024;
var bacia = ee.FeatureCollection('projects/iclei-494717/assets/Bacia_POA_Buffer_4326');
var escala = 5000;

Map.centerObject(bacia, 8);

// ====================================================================
// CARREGAR DADOS DIÁRIOS DO ERA5-LAND PARA O ANO
// ====================================================================
var inicio = ee.Date.fromYMD(ano, 1, 1);
var fim = ee.Date.fromYMD(ano, 12, 31);

var era5 = ee.ImageCollection('ECMWF/ERA5_LAND/DAILY_AGGR')
  .filterDate(inicio, fim)
  .filterBounds(bacia.geometry());

// ====================================================================
// CALCULAR TEMPERATURA MÉDIA ANUAL
// A banda 'temperature_2m' já representa a média diária do ar a 2m.
// Portanto, a média de todos os dias do ano fornece a média anual.
// ====================================================================
var tmed = era5.select('temperature_2m')   // temperatura média diária a 2m
  .mean()                                  // média de todos os dias do ano
  .rename('tmed');

// ====================================================================
// RECORTAR O RASTER PELA GEOMETRIA DO ASSET
// ====================================================================
var tmedRecortado = tmed.clip(bacia.geometry());

// ====================================================================
// EXTRAIR O VALOR MÉDIO DA TEMPERATURA DENTRO DE CADA FEIÇÃO
// ====================================================================
var stats = tmedRecortado.reduceRegions({
  collection: bacia,
  reducer: ee.Reducer.mean(),
  scale: escala
});

// Adiciona o ano como propriedade
var resultado = stats.map(function(f) {
  return f.set('year', ano);
});

// ====================================================================
// EXPORTAR CSV PARA O GOOGLE DRIVE
// ====================================================================
Export.table.toDrive({
  collection: resultado,
  description: 'Tmed_' + ano + '_BaciaPOA',
  fileFormat: 'CSV',
  selectors: ['system:index', 'year', 'tmed']  // usa system:index como identificador
});

// ====================================================================
// EXPORTAR RASTER RECORTADO (opcional)
// ====================================================================
Export.image.toDrive({
  image: tmedRecortado,
  description: 'Tmed_raster_' + ano + '_BaciaPOA',
  fileNamePrefix: 'Tmed_raster_' + ano + '_BaciaPOA',
  region: bacia.geometry(),
  scale: escala,
  crs: 'EPSG:4326',
  maxPixels: 1e13
});

// ====================================================================
// VISUALIZAR NO MAPA
// ====================================================================
Map.addLayer(tmedRecortado, {min: 290, max: 305, palette: ['blue', 'green', 'yellow', 'red']}, 'Tmed ' + ano);
Map.addLayer(bacia.style({color: 'red', fillColor: '00000000', width: 2}), {}, 'Limite da Bacia');
